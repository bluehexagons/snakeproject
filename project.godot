[layer_names]

3d_physics/layer_1="Ground"
3d_physics/layer_2="Rocks"
3d_physics/layer_3="Head"
3d_physics/layer_4="Body"
3d_physics/layer_5="Walls"

[physics]

3d/run_on_separate_thread=false
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/physics_jitter_fix=0.0
3d/physics_engine="JoltPhysics3D"
3d/default_gravity=25.0
3d/solver/solver_iterations=12

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
