[sub_resource type="Shader" id="Shader_1"]
code = "shader_type spatial;
render_mode unshaded, depth_prepass_alpha;

uniform float speed : hint_range(0.1, 2.0) = 0.2;
uniform float scale : hint_range(1.0, 10.0) = 3.0;
uniform vec4 color_1 : source_color = vec4(0.1, 0.15, 0.2, 1.0);
uniform vec4 color_2 : source_color = vec4(0.15, 0.2, 0.25, 1.0);

void fragment() {
    vec2 scaled_uv = UV * scale;
    float t = TIME * speed;
    
    float n1 = sin(scaled_uv.x + t) * sin(scaled_uv.y + t);
    float n2 = sin(scaled_uv.x * 1.5 - t * 1.3) * sin(scaled_uv.y * 1.5 + t * 0.7);
    
    float mixed = mix(n1, n2, 0.5) * 0.5 + 0.5;
    
    ALBEDO = mix(color_1, color_2, mixed).rgb;
    ALPHA = 0.7;
}"

